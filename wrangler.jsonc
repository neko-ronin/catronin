{
  // Deploys ./dist as a static-asset Worker. Static asset requests are free
  // and unlimited on Cloudflare, including the Free plan.
  "name": "catronin",
  "compatibility_date": "2026-09-24",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // Custom domains are created by `wrangler deploy` itself: the zone is already
  // in this Cloudflare account, so this adds the DNS record and issues TLS.
  "routes": [
    { "pattern": "catronin.com", "custom_domain": true },
    { "pattern": "www.catronin.com", "custom_domain": true }
  ]
}
